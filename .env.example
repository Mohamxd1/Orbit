# Copy to .env and adjust. All ORBIT_* values are optional; defaults shown.

# --- State store (docker-compose.yml builds this from the POSTGRES_* values) ---
POSTGRES_USER=orbit
POSTGRES_PASSWORD=change-me
POSTGRES_DB=orbit
# For a local run without Docker Compose:
# ORBIT_DATABASE_URL=sqlite:///./orbit.db

# --- Monitoring ---
ORBIT_LABEL=orbit.enable
ORBIT_POLL_INTERVAL=10
ORBIT_FAILURE_THRESHOLD=2
ORBIT_HEARTBEAT_TIMEOUT=3

# --- Recovery policy ---
ORBIT_COOLDOWN_SECONDS=60
ORBIT_MAX_RESTARTS=3
ORBIT_RESTART_WINDOW_SECONDS=600
ORBIT_VALIDATION_TIMEOUT=60
ORBIT_VALIDATION_STABLE_SECONDS=10

# --- Server ---
ORBIT_PUBLISH_PORT=8080
ORBIT_LOG_LEVEL=INFO
